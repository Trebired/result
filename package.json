{
  "bugs": {
    "url": "https://github.com/Trebired/result/issues"
  },
  "description": "Shared result builders and transport-agnostic response orchestration for Bun and Node.js products.",
  "devDependencies": {
    "@trebired/code-discipline": "^3.1.1",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.1",
    "typescript": "^6.0.2"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/Trebired/result#readme",
  "imports": {
    "#89og18ildn0f": "./test/specs/presets.spec.ts",
    "#cqh3tzy8af60": "./test/specs/responder.spec.ts",
    "#fkl0t1n99da1": "./src/responder_support.ts",
    "#index": "./src/index.ts",
    "#mo7xcevtwj2o": "./tb.code-discipline.ts",
    "#presets": "./src/presets.ts",
    "#responder": "./src/responder.ts",
    "#result": "./src/result.ts",
    "#rw8w0e1qwb29": "./test/specs/result.spec.ts",
    "#shared": "./src/shared.ts",
    "#types": "./src/types.ts"
  },
  "keywords": [
    "result",
    "response",
    "http",
    "rendering",
    "backend",
    "node",
    "bun"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@trebired/result",
  "packageManager": "bun@1.3.12",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/result"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/prepare-dist.mjs prepare-dist",
    "postpack": "node ./scripts/prepare-dist.mjs postpack",
    "prepack": "bun run build && node ./scripts/prepare-dist.mjs prepack",
    "prepublishOnly": "bun run typecheck && bun test && bun run verify:pack",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:pack": "node ./scripts/verify-pack.mjs"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.0"
}
