{
  "name": "@trebired/result",
  "version": "1.0.3",
  "description": "Shared result builders, response orchestration, and failure tracing for Bun and Node.js products.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/prepare-dist.mjs prepare-dist",
    "postpack": "node ./scripts/prepare-dist.mjs postpack",
    "prepack": "bun run build && node ./scripts/prepare-dist.mjs prepack",
    "prepublishOnly": "bun run typecheck && bun run verify:pack",
    "typecheck": "tsc --noEmit",
    "verify:pack": "node ./scripts/verify-pack.mjs"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.2.3"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^4.7.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "result",
    "response",
    "tracing",
    "errors",
    "http",
    "rendering",
    "backend",
    "node",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/result"
  },
  "homepage": "https://github.com/Trebired/result#readme",
  "bugs": {
    "url": "https://github.com/Trebired/result/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
